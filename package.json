{
  "name": "iwms-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "start": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:foundation": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "gsap": "^3.13.0",
    "@gsap/react": "^2.1.2",
    "lenis": "^1.3.0",
    "framer-motion": "^12.0.0",
    "@rive-app/react-canvas": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react-hook-form": "^7.0.0",
    "zod": "^4.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/montserrat": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "vite": "^8.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "globals": "^16.0.0"
  }
}
